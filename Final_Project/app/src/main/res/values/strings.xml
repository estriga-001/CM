    <string name="help_faq_2_q">What is DrivePulse Premium?</string>
    <string name="help_faq_2_a">Premium gives you access to advanced metrics, exclusive club events, and group runs for just 1€/month.</string>
    <string name="help_faq_3_q">How do I change my profile picture?</string>
