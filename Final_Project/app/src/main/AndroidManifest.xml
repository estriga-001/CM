<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest for DrivePulse.
    Declares all permissions, Activities, services and meta-data.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Foreground Service for run tracking -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Media -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <application
        android:name=".DrivePulseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrivePulse"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="34">

        <!-- Google Maps API Key from local.properties -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- SplashActivity — start menu / launcher -->
        <activity
            android:name=".feature.start.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DrivePulse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AuthActivity — authentication flow -->
        <activity
            android:name=".feature.auth.AuthActivity"
            android:exported="true"
            android:theme="@style/Theme.DrivePulse" />

        <!-- MainActivity — main navigation host -->
        <activity
            android:name=".feature.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DrivePulse" />

        <!-- RunRecorderActivity — GPS tracking during a run -->
        <activity
            android:name=".feature.run.RunRecorderActivity"
            android:exported="false"
            android:theme="@style/Theme.DrivePulse"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <!-- RouteDetailActivity — view route details -->
        <activity
            android:name=".feature.routedetail.RouteDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.DrivePulse" />

        <!-- Tracking Foreground Service -->
        <service
            android:name=".core.location.TrackingForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Sync locales for backward compatibility with older devices -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
