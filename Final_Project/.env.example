# DrivePulse environment example
# Do not rename this file to .env and commit real secrets.
# Android should use local.properties/BuildConfig for local keys.

FIREBASE_PROJECT_ID=drivepulse-dev
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_STORAGE_BUCKET=drivepulse-dev.appspot.com

GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_ACCESS_TOKEN=optional_if_using_mapbox

OPEN_METEO_BASE_URL=https://api.open-meteo.com/

CLOUD_FUNCTIONS_REGION=europe-west1
IMAGE_GENERATION_PROXY_URL=https://example.cloudfunctions.net/generateCarAvatar

ENABLE_PREMIUM_SIMULATION=true
ENABLE_FAKE_DATA=true
